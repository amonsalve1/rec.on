# copy to .env and fill in. .env is gitignored and must stay that way.
# generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(64))"

DATABASE_URL=postgresql+psycopg://recon:recon@localhost:5432/recon

# signing key for access tokens
JWT_SECRET_KEY=

# set only while rotating: old key stays accepted for verification until
# every access token signed with it has expired (10 minutes)
JWT_SECRET_KEY_PREVIOUS=

# keyed hash for invite codes and per-user deck shuffling. rotating this
# invalidates every outstanding invite code.
SERVER_PEPPER=

# contact address sent to overpass, required by their fair use policy
OVERPASS_USER_AGENT=recon/1.0 (you@example.com)
